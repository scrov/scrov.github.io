{
  "name": "scrov-home",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"shadow-cljs watch client server\" \"node target/server.js\"",
    "build": "shadow-cljs release client server",
    "start": "node target/server.js",
    "fennel": "fennel --compile fennel/api.fnl lua/api.lua",
    "melange": "dune build",
    "openresty:test": "sudo openresty -t",
    "openresty:reload": "sudo openresty -s reload"
  },
  "dependencies": {
    "clipboardy": "^4.0.0",
    "fengari": "^0.1.5",
    "fengari-interop": "^0.1.4",
    "fengari-web": "^0.1.4",
    "node-gyp": "^13.0.1",
    "plantuml": "^0.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@wdio/browser-runner": "^9.31.1",
    "concurrently": "^9.2.1",
    "shadow-cljs": "^2.28.23",
    "shx": "^0.4.0"
  }
}
